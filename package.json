{
  "name": "effectful-better-auth",
  "version": "0.1.1",
  "description": "Effect v4 integration for Better Auth: plugin-aware service/Layer factory and an effectful auth.api proxy with tagged errors.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [],
  "keywords": [
    "effect",
    "better-auth",
    "authentication",
    "auth",
    "typescript",
    "session"
  ],
  "homepage": "https://github.com/brandhaug/effectful-better-auth#readme",
  "bugs": {
    "url": "https://github.com/brandhaug/effectful-better-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/effectful-better-auth.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "catalog": {
    "@types/node": "24",
    "better-auth": "1.7.1",
    "effect": "4.0.0-rc.110",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "better-auth": "^1.6.0",
    "effect": "^4.0.0-rc.110"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "nanoid@<3.3.18": "3.3.18"
  }
}
